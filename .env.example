SECRET_KEY=replace-with-strong-secret
JWT_SECRET_KEY=replace-with-strong-jwt-secret
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/weddingflix?retryWrites=true&w=majority
DEFAULT_ADMIN_EMAIL=admin@weddingflix.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_DEVELOPER_EMAIL=developer@wedflix.com
DEFAULT_DEVELOPER_PASSWORD=developer123
DEFAULT_GUEST_EMAIL=guest@weddingflix.com
DEFAULT_GUEST_PASSWORD=guest123
MAX_CONTENT_LENGTH=67108864
MAX_AUDIO_UPLOAD_BYTES=8388608
TELEGRAM_PHOTO_MAX_DIMENSION=1600
TELEGRAM_PHOTO_JPEG_QUALITY=78
TELEGRAM_MUSIC_TRIM_SECONDS=90
TELEGRAM_MUSIC_BITRATE=96k
FACE_INDEX_ENABLED=0
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
PUBLIC_BACKEND_URL=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_IMPORT_LIMIT=100
FLASK_ENV=development
PORT=5000

# Optional AI copy generation for blank/default story text.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Email OTP delivery. Required in production for signup and password reset.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM_EMAIL=your-gmail-address@gmail.com
# SMTP_FROM_NAME=Wedflix
# SMTP_USE_SSL=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Wedflix
SMTP_USE_SSL=0

# Recommended for Render free services because outbound SMTP ports are blocked.
# Brevo API email:
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Wedflix

# Resend API email:
# Create a Resend API key and verify your sender domain before using it with real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Wedflix
