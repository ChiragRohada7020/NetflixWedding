SECRET_KEY=replace-with-strong-secret
JWT_SECRET_KEY=replace-with-strong-jwt-secret
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/weddingflix?retryWrites=true&w=majority
DEFAULT_ADMIN_EMAIL=admin@weddingflix.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_GUEST_EMAIL=guest@weddingflix.com
DEFAULT_GUEST_PASSWORD=guest123
MAX_CONTENT_LENGTH=67108864
MAX_AUDIO_UPLOAD_BYTES=8388608
ENABLE_FACE_MATCH=0
PRELOAD_FACE_MODEL=0
FACE_MATCH_SERVICE_URL=
FACE_MATCH_SERVICE_TOKEN=
FACE_MATCH_THRESHOLD=0.68
FLASK_ENV=development
PORT=5000
